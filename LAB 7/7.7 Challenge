public class Task77 {

    public static boolean isPalindrome(int n) {

        int original = n;
        int reverse = 0;

        while (n > 0) {
            int digit = n % 10;
            reverse = reverse * 10 + digit;
            n /= 10;
        }

        return original == reverse;
    }

    public static void main(String[] args) {

        System.out.println("Palindrome numbers from 100 to 999:");

        for (int i = 100; i <= 999; i++) {

            if (isPalindrome(i)) {
                System.out.print(i + " ");
            }
        }
    }
}
