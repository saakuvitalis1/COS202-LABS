let secret = Math.floor(Math.random() * 100) + 1;
let guess;
let attempts = 0;

do {
    guess = Number(prompt("Guess a number between 1 and 100"));
    attempts++;

    if (guess > secret) {
        console.log("Too high!");
    } else if (guess < secret) {
        console.log("Too low!");
    } else {
        console.log("Correct!");
        console.log("Attempts:", attempts);
    }

} while (guess !== secret);
