let score = Number(prompt("Enter your score:"));

if (score < 0 || score > 100) {
    console.log("Invalid score");
}
else if (score >= 70) {
    console.log("Grade A");
}
else if (score >= 60) {
    console.log("Grade B");
}
else if (score >= 50) {
    console.log("Grade C");
}
else if (score >= 45) {
    console.log("Grade D");
}
else if (score >= 40) {
    console.log("Grade E");
}
else {
    console.log("Grade F");
}
