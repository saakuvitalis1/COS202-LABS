import java.util.Scanner;

public class Task87 {
    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        int[][] matrix = new int[3][3];

        System.out.println("Enter 9 matrix elements:");

        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                matrix[i][j] = input.nextInt();
            }
        }

        System.out.println("Matrix:");

        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                System.out.print(matrix[i][j] + " ");
            }
            System.out.println();
        }

        for (int i = 0; i < 3; i++) {
            int rowSum = 0;

            for (int j = 0; j < 3; j++) {
                rowSum += matrix[i][j];
            }

            System.out.println("Row " + (i + 1) + " Sum: " + rowSum);
        }

        for (int j = 0; j < 3; j++) {
            int columnSum = 0;

            for (int i = 0; i < 3; i++) {
                columnSum += matrix[i][j];
            }

            System.out.println("Column " + (j + 1) + " Sum: " + columnSum);
        }

        int diagonalSum = 0;

        for (int i = 0; i < 3; i++) {
            diagonalSum += matrix[i][i];
        }

        System.out.println("Main Diagonal Sum: " + diagonalSum);
    }
}
